# App
NEXT_PUBLIC_APP_URL= # Your production domain, e.g. https://referral.yourdomain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_SECRET=

# Cron protection
CRON_SECRET=

# Internal webhook secret for subscription events — set in Vercel env vars
# TODO PR 5-A: Replace with real payment provider HMAC signature validation
SUBSCRIPTION_WEBHOOK_SECRET=

# Payment providers
TRANSAK_API_KEY=
TRANSAK_WEBHOOK_SECRET=
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=

# Off-ramp
TRIPLE_A_API_KEY=
XANPOOL_API_KEY=

# Helius (Solana)
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# KYC hashing (salt stored in Supabase Vault, not here)
# KYC_HMAC_SALT — set in Supabase Vault only, never in .env

# Email
RESEND_API_KEY=
FROM_EMAIL= # Verified sender address in your Resend account

# Monitoring
BETTERSTACK_HEARTBEAT_URL=
BETTERSTACK_HEARTBEAT_CONFIRM_REFERRALS=
BETTERSTACK_HEARTBEAT_RECURRING_PAYOUTS=
BETTERSTACK_HEARTBEAT_FRAUD_SCAN=
# Trust score monthly recalculation cron heartbeat
BETTERSTACK_HEARTBEAT_TRUST_RECALC=
SENTRY_DSN=
